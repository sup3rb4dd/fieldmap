<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/SettingsHeader" android:text="◆ SYSTEM CONFIG" android:textSize="20sp" />
        <TextView style="@style/HudLabel" android:text="// OPERATOR · NET · DISPLAY" />

        <TextView style="@style/SettingsLabel" android:text="// Callsign (required for APRS TX)" />
        <EditText android:id="@+id/setCall" style="@style/SettingsField"
            android:hint="e.g. KF0ABC" android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="6" />

        <TextView style="@style/SettingsLabel" android:text="// SSID — 7 handheld · 9 vehicle · 0 none" />
        <EditText android:id="@+id/setSsid" style="@style/SettingsField" android:inputType="number" android:maxLength="2" />

        <TextView style="@style/SettingsLabel" android:text="// Team net name (group chat, max 9)" />
        <EditText android:id="@+id/setGroup" style="@style/SettingsField"
            android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="9" />

        <TextView style="@style/SettingsLabel" android:text="// Position report interval" />
        <Spinner android:id="@+id/setBeacon" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/hud_field" />

        <TextView style="@style/SettingsLabel" android:text="// APRS digi path (blank = direct)" />
        <EditText android:id="@+id/setPath" style="@style/SettingsField"
            android:inputType="textCapCharacters|textNoSuggestions" />

        <TextView style="@style/SettingsLabel" android:text="// APRS map symbol" />
        <Spinner android:id="@+id/setSymbol" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/hud_field" />

        <TextView style="@style/SettingsLabel" android:text="// Status text with position" />
        <EditText android:id="@+id/setComment" style="@style/SettingsField" android:inputType="text" android:maxLength="40" />

        <TextView style="@style/SettingsLabel" android:text="// Track filter (callsigns / !nodeids, blank = all)" />
        <EditText android:id="@+id/setFilter" style="@style/SettingsField"
            android:hint="e.g. KF0ABC, KF0XYZ" android:inputType="textCapCharacters|textNoSuggestions" />

        <TextView style="@style/SettingsHeader" android:layout_marginTop="28dp" android:text="◆ GMRS MODE" />
        <CheckBox android:id="@+id/setGmrs" style="@style/HudCheck"
            android:text="GMRS mode: the UV-PRO link sends texts and map data on GMRS instead of ham APRS" />
        <TextView style="@style/SettingsLabel" android:text="// GMRS callsign (on your FCC licence)" />
        <EditText android:id="@+id/setGmrsCall" style="@style/SettingsField"
            android:hint="e.g. WRXX123" android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="7" />
        <TextView style="@style/SettingsLabel" android:text="// Unit name for this radio (max 6, e.g. ELI)" />
        <EditText android:id="@+id/setGmrsUnit" style="@style/SettingsField"
            android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="6" />
        <CheckBox android:id="@+id/setGmrsPos" style="@style/HudCheck"
            android:text="Send my position automatically on GMRS (uses the report interval above)" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/dim" android:textSize="11sp"
            android:text="While this is on, an amber GMRS MODE bar stays on the map and chat. The app keeps to the FCC data rules for GMRS: bursts of one second or less (60-character texts), one burst every 30 seconds, no relays. Messages wait in line for their turn. Everyone in the group needs GMRS mode on, the same team name, and the same channel (1-22; not a repeater channel). GMRS is not encrypted. The app cannot set the radio's channel: tune that on the radio. One GMRS licence covers your immediate family; each radio gets its own unit name." />

        <TextView style="@style/SettingsHeader" android:layout_marginTop="28dp" android:text="◆ PRIVACY" />

        <TextView style="@style/SettingsLabel" android:text="// Meshtastic team channel" />
        <Spinner android:id="@+id/setMeshCh" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/hud_field" />
        <CheckBox android:id="@+id/setMeshCh0Ok" style="@style/HudCheck"
            android:text="Channel 0 is private on our radios (we changed its key)" />
        <CheckBox android:id="@+id/setTeamOnly" style="@style/HudCheck"
            android:text="Only show mesh nodes &amp; waypoints from the team channel" />
        <CheckBox android:id="@+id/setAprsTeam" style="@style/HudCheck"
            android:text="Send team chat &amp; waypoints over APRS (PUBLIC)" />
        <CheckBox android:id="@+id/setAprsPos" style="@style/HudCheck"
            android:text="Send my position over APRS (PUBLIC)" />
        <CheckBox android:id="@+id/setNogate" style="@style/HudCheck"
            android:text="Keep my APRS packets off the internet (NOGATE). SOS is never held back." />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/dim" android:textSize="11sp"
            android:text="Mesh traffic is encrypted with the team channel's key: only radios with that key can read it. On a radio with factory settings, channel 0 is the public channel that every Meshtastic user nearby shares, so team traffic is held on channel 0 until you tick the box above or pick your private channel. APRS can't be encrypted (FCC rules) — anyone with a scanner can read it." />

        <TextView style="@style/SettingsHeader" android:layout_marginTop="28dp" android:text="◆ TAK LINK (ATAK / WINTAK / ITAK)" />
        <CheckBox android:id="@+id/setTakLan" style="@style/HudCheck"
            android:text="Link with TAK devices on the same Wi-Fi" />
        <TextView style="@style/SettingsLabel" android:text="// TAK server (host:port, blank = none)" />
        <EditText android:id="@+id/setTakServer" style="@style/SettingsField"
            android:hint="e.g. 192.168.1.50:8087" android:inputType="textUri|textNoSuggestions" />
        <TextView style="@style/SettingsLabel" android:text="// Name shown to TAK users" />
        <EditText android:id="@+id/setTakCall" style="@style/SettingsField"
            android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="20" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/dim" android:textSize="11sp"
            android:text="While this is on, your position goes to that network about once a minute, and team chat, shared waypoints and drawings go there too. Servers: plain TCP only (FreeTAKServer / OpenTAKServer style, usually port 8087). That connection is NOT encrypted, so use it on networks you trust. Servers that need certificates are not supported yet." />

        <TextView style="@style/SettingsHeader" android:layout_marginTop="28dp" android:text="◆ BACKGROUND &amp; ALERTS" />
        <CheckBox android:id="@+id/setBackground" style="@style/HudCheck"
            android:text="Keep radios connected with the screen off" />
        <CheckBox android:id="@+id/setAutoConnect" style="@style/HudCheck"
            android:text="Reconnect my radios when the app opens" />
        <CheckBox android:id="@+id/setAlertSos" style="@style/HudCheck"
            android:text="SOS alarm: loud, even with the ringer silenced" />
        <CheckBox android:id="@+id/setWeather" style="@style/HudCheck"
            android:text="Severe weather warnings (needs internet)" />
        <CheckBox android:id="@+id/setAlertMsg" style="@style/HudCheck"
            android:text="Alert on new messages" />
        <CheckBox android:id="@+id/setAlertWpt" style="@style/HudCheck"
            android:text="Alert on new shared waypoints" />
        <CheckBox android:id="@+id/setAlertOverdue" style="@style/HudCheck"
            android:text="Alert when a teammate stops reporting" />
        <TextView style="@style/SettingsLabel" android:text="// Overdue after" />
        <Spinner android:id="@+id/setOverdueMin" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/hud_field" />

        <TextView style="@style/SettingsHeader" android:layout_marginTop="28dp" android:text="◆ DISPLAY" />
        <TextView style="@style/SettingsLabel" android:text="// Map detail" />
        <Spinner android:id="@+id/setDetail" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/hud_field" />

        <CheckBox android:id="@+id/setElevation" style="@style/HudCheck"
            android:layout_marginTop="12dp" android:text="Show ground elevation at the crosshair (downloads height data)" />
        <CheckBox android:id="@+id/setTrails" style="@style/HudCheck"
            android:text="Record and show trails (mine and teammates')" />
        <CheckBox android:id="@+id/setImperial" style="@style/HudCheck"
            android:text="Imperial units (mi / ft)" />
        <CheckBox android:id="@+id/setKeepOn" style="@style/HudCheck" android:text="Keep screen on" />
        <CheckBox android:id="@+id/setPlain" style="@style/HudCheck"
            android:text="Plain button labels (ME, +PIN, MAP, CHAT, TEAM) instead of POS, +WPT, LYR, MSG, TRK" />
        <CheckBox android:id="@+id/setLocalTime" style="@style/HudCheck"
            android:text="Show local time instead of Zulu (UTC)" />
        <CheckBox android:id="@+id/setUpdateCheck" style="@style/HudCheck"
            android:text="Tell me when a newer build is out (asks GitHub once a day)" />

        <Button android:id="@+id/setSave" style="@style/HudBigButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="[ COMMIT CONFIG ]" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/dim" android:textSize="11sp"
            android:text="Transmitting APRS on the UV-PRO uses amateur frequencies and needs an amateur license; without a callsign, FieldMap only listens on APRS. Meshtastic runs on license-free 915 MHz and works without a callsign. Team chat goes out on every connected radio." />
    </LinearLayout>
</ScrollView>
