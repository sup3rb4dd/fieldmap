<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:src="@drawable/crosshair"
        android:contentDescription="center" />

    <!-- ===== top HUD + alert banners ===== -->
    <LinearLayout
        android:id="@+id/topBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="8dp"
        android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hud_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◆ FIELDMAP"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:text="// TAC-NET"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />
            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="4dp"
                android:text="000000Z"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/grid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/radioStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="■ COMMS: OFFLINE"
                android:textColor="@color/dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <Button android:id="@+id/btnChat" style="@style/BarButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MSG" />
            <Button android:id="@+id/btnList" style="@style/BarButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRK" />
            <Button android:id="@+id/btnMenu" style="@style/BarButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="≡" android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

        <TextView
            android:id="@+id/tvSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="10dp"
            android:textColor="@color/bad"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvWx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="10dp"
            android:textColor="@color/warn"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== tool rail ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <Button android:id="@+id/btnMe" style="@style/RoundButton" android:text="POS" />
        <Button android:id="@+id/btnPin" style="@style/RoundButton" android:text="+WPT" />
        <Button android:id="@+id/btnDraw" style="@style/RoundButton" android:text="DRAW" />
        <Button android:id="@+id/btnGrid" style="@style/RoundButton" android:text="GRID" />
        <Button android:id="@+id/btnLayer" style="@style/RoundButton" android:text="LYR" />
        <Button android:id="@+id/btnNorth" style="@style/RoundButton" android:text="N↑" />
        <Button android:id="@+id/btnSos" style="@style/RoundButton" android:layout_marginTop="16dp"
            android:background="@drawable/hud_button_red" android:textColor="@color/bad" android:text="SOS" />
    </LinearLayout>

    <!-- ===== bottom HUD ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:background="@drawable/hud_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/drawRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvDraw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Button android:id="@+id/btnUndo" style="@style/BarButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UNDO" />
            <Button android:id="@+id/btnDone" style="@style/BarButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DONE" />
            <Button android:id="@+id/btnDrawCancel" style="@style/BarButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/targetRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <app.fieldmap.ArrowView
                android:id="@+id/navArrow"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="10dp" />
            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/warn"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Button android:id="@+id/btnClearTarget" style="@style/BarButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView style="@style/HudLabel" android:text="POS " />
            <TextView
                android:id="@+id/tvMe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACQUIRING GPS…"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />
            <TextView
                android:id="@+id/tvHdg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/grid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView style="@style/HudLabel" android:text="CTR " />
            <TextView
                android:id="@+id/tvCenter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/warn"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
