<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hud_panel"
        android:padding="12dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <ListView
        android:id="@+id/chatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:divider="@color/grid"
        android:dividerHeight="1dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/q1" style="@style/BarButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:text="OK" />
            <Button android:id="@+id/q2" style="@style/BarButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ON MY WAY" />
            <Button android:id="@+id/q3" style="@style/BarButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ARRIVED" />
            <Button android:id="@+id/q4" style="@style/BarButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEED PICKUP" />
            <Button android:id="@+id/q5" style="@style/BarButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WHERE ARE YOU?" />
            <Button android:id="@+id/qGrid" style="@style/BarButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ MY GRID" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hud_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView style="@style/HudLabel" android:text="TO ▸ " />
            <EditText
                android:id="@+id/chatTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="textNoSuggestions"
                android:maxLength="12"
                android:textColor="@color/warn"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@color/grid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView style="@style/HudLabel" android:text="&gt; " android:textColor="@color/accent" android:textSize="16sp" />
            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="ENTER TRAFFIC_"
                android:inputType="textCapSentences"
                android:textColor="@color/accent"
                android:textColorHint="@color/dim" />
            <Button
                android:id="@+id/chatSend"
                style="@style/BarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ TX ]" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
