<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/accent" /></shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/panel" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                </shape>
            </item>
            <item android:gravity="top|end" android:width="6dp" android:height="6dp" android:top="3dp" android:right="3dp">
                <shape><solid android:color="@color/dim" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
