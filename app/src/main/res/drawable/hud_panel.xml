<?xml version="1.0" encoding="utf-8"?>
<!-- black panel, thin green frame, bright corner brackets -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="@color/dim" />
        </shape>
    </item>
    <item android:gravity="top|start" android:width="14dp" android:height="2dp"><shape><solid android:color="@color/accent" /></shape></item>
    <item android:gravity="top|start" android:width="2dp" android:height="14dp"><shape><solid android:color="@color/accent" /></shape></item>
    <item android:gravity="top|end" android:width="14dp" android:height="2dp"><shape><solid android:color="@color/accent" /></shape></item>
    <item android:gravity="top|end" android:width="2dp" android:height="14dp"><shape><solid android:color="@color/accent" /></shape></item>
    <item android:gravity="bottom|start" android:width="14dp" android:height="2dp"><shape><solid android:color="@color/accent" /></shape></item>
    <item android:gravity="bottom|start" android:width="2dp" android:height="14dp"><shape><solid android:color="@color/accent" /></shape></item>
    <item android:gravity="bottom|end" android:width="14dp" android:height="2dp"><shape><solid android:color="@color/accent" /></shape></item>
    <item android:gravity="bottom|end" android:width="2dp" android:height="14dp"><shape><solid android:color="@color/accent" /></shape></item>
</layer-list>
