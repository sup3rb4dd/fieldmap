<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#FF7A1010" /><stroke android:width="1.5dp" android:color="@color/bad" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="1.5dp" android:color="@color/bad" />
        </shape>
    </item>
</selector>
